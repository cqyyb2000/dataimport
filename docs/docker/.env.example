# 复制为同目录下的 .env 后修改（不要提交真实密码）
# cp .env.example .env

# MySQL
MYSQL_ROOT_PASSWORD=ChangeMe_Root_StrongPass
MYSQL_DATABASE=dataimport
MYSQL_USER=dataimport
MYSQL_PASSWORD=ChangeMe_User_StrongPass

# 与后端 set.config 一致的安全密钥（生产务必修改）
SECRET_KEY=ChangeMe_Flask_Secret
JWT_SECRET_KEY=ChangeMe_JWT_Secret
JWT_ACCESS_TOKEN_EXPIRES=3600

# 对外端口（宿主机）
HTTP_PORT=80

# 时区
TZ=Asia/Shanghai

# 宿主机数据目录（物理盘）
DATA_ROOT=/home/mysqldata
