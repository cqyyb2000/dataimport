# Docker Compose 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# MySQL 数据库配置
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=docwebdb
MYSQL_USER=docwebuser
MYSQL_PASSWORD=docwebpass

# 时区设置
TZ=Asia/Shanghai

# 注意：
# 1. 生产环境请修改所有密码为强密码
# 2. 确保 MYSQL_PASSWORD 与 set.config 中的 DB_PASSWORD 一致
# 3. 确保 MYSQL_DATABASE 与 set.config 中的 DB_NAME 一致
# 4. 确保 MYSQL_USER 与 set.config 中的 DB_USER 一致

